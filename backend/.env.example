# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# 高德开放平台「Web服务」类型 Key（https://console.amap.com/dev/key/app）
AMAP_KEY=

# LLM（OpenAI 兼容接口，DeepSeek/Qwen/豆包均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat

# ---- 轻任务快模型通道（可选）----
# 评价生成、对话意图解析这类轻任务可单独指向更快的模型/供应商，
# 不配就自动回落上面的主模型。示例（智谱 GLM-4-Flash，免费且快）：
# LLM_FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_FAST_API_KEY=your_key
# LLM_FAST_MODEL=glm-4-flash
# 其他可选：阿里百炼 qwen-turbo、硅基流动 Qwen2.5-7B-Instruct
