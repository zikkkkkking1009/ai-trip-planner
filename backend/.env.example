# ============================================================
# 路书 · AI 行程规划 —— 环境变量模板
#
# 用法：
#     cp backend/.env.example backend/.env
#     然后填值、重启服务。
#
# .env 已在 .gitignore 与 .dockerignore 里排除 —— 不会进仓库，也不会进镜像。
# 改完 .env 必须**重启服务**才生效（启动时一次性读入进程环境，之后不再读文件）。
#
# 标记说明：
#   [必需*] = 不配则**对应功能**返回 503 或自动降级；服务本身仍能起来、能跑演示
#   [可选]  = 不配不影响主流程
#   严格说没有任何一项是「不配就起不来」：演示景点、排期求解、地图、天气、
#   稳健性模拟全部零 Key 可用。下面每一项都写清了「不配的后果」。
#
# 配好后建议先跑一次自检，别等重启了才发现 Key 错了：
#     python backend/selftest.py
# ============================================================

# ------------------------------------------------------------
# 一、高德开放平台（真实驾车通勤 / POI 检索 / 景点详情与实景图）
# [必需*] 不配 →
#     · 通勤降级为直线估算（页面会如实显示「直线估算（降级）」）
#     · POI 对齐全部转「人工确认」，粘贴的攻略采纳不了坐标
#     · 未收录景点的详情接口返回 404（已缓存的 spot_media.json 零 Key 可用）
#
# 申请：高德开放平台控制台 → 应用管理 → 创建应用 → 添加 Key
#       https://console.amap.com/dev/key/app
#       ⚠️ 服务平台必须选「**Web 服务**」。选成「Web 端(JS)」会一直报
#       USERKEY_PLAT_NOMATCH —— Key 本身是真的，只是类型不对，这是最常踩的坑。
# 免费额度：个人开发者按服务类型各有日调用量上限，**具体数字以控制台「配额」页为准**
#           （本项目对通勤与 POI 结果做了三级缓存，正常演示远低于任何一档上限）
# 建议：在控制台给这个 Key 单设一个日调用上限 —— 被盗用时的硬止损
AMAP_KEY=

# ------------------------------------------------------------
# 二、主模型（重任务：攻略抽取、AI 总评、对话改行程的意图解析）
# [必需*] 不配 →
#     · /extract 与 /plan/review 返回 503 并说明原因
#     · /plan/edit（小舟对话）无法解析指令
#     · 景点详情里的 AI 评价区整块隐藏（前端有占位，不报错）
#
# 任何 OpenAI 兼容接口都能用，换供应商只改 LLM_BASE_URL + LLM_MODEL_ID。
# 常见选择：DeepSeek 开放平台（下面默认示例）／阿里百炼／火山方舟(豆包)／
#           硅基流动／智谱 —— 都需要先在控制台实名认证并创建 API Key。
# 计费：按 token 计费，**单价与赠送额度以各控制台当期为准**（不在这里写数字，免得过期误导）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat

# ------------------------------------------------------------
# 三、轻任务快通道（可选：只有「景点评价生成」走这条通道）
# [可选] 不配 → **逐变量**回落到上面的主模型配置，功能完全不受影响
#
# 意图解析与 AI 总评**固定**用主模型（实测主模型响应更快，见 docs/experiments.md 实验三）；
# 只有评价生成是后台预取、不在用户等待路径上，才值得指向更快/更省的模型。
# 示例（智谱 GLM-4-Flash，免费档，以控制台当期政策为准）：
#   LLM_FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_FAST_API_KEY=<智谱控制台拿到的 Key>
#   LLM_FAST_MODEL=glm-4-flash
#
# ⚠️ 两个务必读的坑：
#   1) LLM_FAST_BASE_URL 一旦指向**别家供应商**，必须同时设置 LLM_FAST_API_KEY。
#      否则程序会拿「主模型的 Key」去请求别家的地址 —— 结果是一路 401，
#      而日志看起来像「模型坏了」。只改 URL 不配 Key 是最常见的配错方式；
#      只有「快通道与主通道同一家」时，省略 LLM_FAST_API_KEY 才成立。
#      （启动自检会把这种情况直接标成「已配置但无效 / fast_key_missing」。）
#   2) 型号选择：实测 glm-4-flash-250414 单轮 0.5~0.8s；更高代号的 flash 档
#      实测很慢或过载，不要用（详见 README 的模型选型一节）。
LLM_FAST_API_KEY=
LLM_FAST_BASE_URL=
LLM_FAST_MODEL=

# ------------------------------------------------------------
# 四、地图底图（可选）
# [可选] amap = 高德栅格瓦片（默认，GCJ-02，不需要 Key）；
#        osm  = OpenStreetMap，前端会自动做 GCJ-02 → WGS84 纠偏
# 合规提醒：高德栅格瓦片仅建议本地开发 / 演示；合规的生产用法是官方 JS API（需另申请 Web端 Key）
TILE_PROVIDER=amap

# ------------------------------------------------------------
# 五、日志与自检（可选）
# LOG_LEVEL=INFO       # DEBUG / INFO / WARNING / ERROR
# LOG_FILE=            # 留空输出到 stdout；填路径则同时写文件
# SELFTEST_SKIP=1      # 置 1 跳过启动时的 Key 可用性自检（默认 0 = 启用）。
#                      # 用途：有 Key 但想完全离线演示，或不想让自检产生任何外呼。
